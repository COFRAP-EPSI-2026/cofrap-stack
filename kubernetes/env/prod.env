# Variables d'environnement pour le déploiement PROD.
# Consommé par deploy.sh / deploy.ps1 / uninstall.sh / uninstall.ps1.

ENV=prod

# Namespaces K8s
NAMESPACE=cofrap
OPENFAAS_FN_NAMESPACE=openfaas-fn
OPENFAAS_NAMESPACE=openfaas

# Releases Helm
RELEASE_BACKEND=cofrap
RELEASE_FRONTEND=cofrap-frontend

# Réseau
METALLB_IP=192.168.1.241

# Hostname public
INGRESS_HOST=cofrap.home-maurras.fr

# Tags d'images publiés par release-please.yml (au merge sur main)
# `latest` = dernière release stable. Pour figer, remplacer par `vX.Y.Z`.
IMAGE_TAG_BACKEND=latest
IMAGE_TAG_FRONTEND=latest
