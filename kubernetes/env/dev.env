# Variables d'environnement pour le déploiement DEV.
# Consommé par deploy.sh / deploy.ps1 / uninstall.sh / uninstall.ps1.
#
# Édite ces valeurs UNIQUEMENT si tu changes d'IP LAN, de hostname ou
# de namespace. Le reste est cohérent avec les charts backend/frontend.
#
# IMPORTANT : pas de commentaire inline après la valeur (`KEY=value  # ...`)
# — bash le supporte mais le parser PowerShell historiquement le ratait. Les
# scripts actuels strippent les commentaires inline, mais on reste propre pour
# éviter tout futur piège.

ENV=dev

# --- Namespaces K8s ---
# Stack (MariaDB + secrets)
NAMESPACE=cofrap-dev
# Fonctions OpenFaaS (défaut OpenFaaS)
OPENFAAS_FN_NAMESPACE=openfaas-fn
# Gateway OpenFaaS
OPENFAAS_NAMESPACE=openfaas

# --- Releases Helm ---
RELEASE_BACKEND=cofrap-dev
RELEASE_FRONTEND=cofrap-frontend-dev

# --- Réseau ---
# IP exposée par MetalLB (L2) au Service traefik
METALLB_IP=192.168.1.240

# --- Hostname public ---
# Cloudflare Tunnel → MetalLB IP → Ingress traefik
INGRESS_HOST=cofrap-dev.home-maurras.fr

# --- Tags d'images (publiés par pre-release.yml sur push branche dev) ---
IMAGE_TAG_BACKEND=dev
IMAGE_TAG_FRONTEND=dev
